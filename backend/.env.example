# Copy to .env and fill in. Never commit .env.
PORT=8787
PROVIDER_MODE=live            # live | fixture (fixture responses are labeled mode: "fixture")
XAI_API_KEY=
XAI_MODEL=grok-4.7            # must support the x_search tool; checked against /v1/models at startup
BACKEND_TOKEN=                # >= 16 chars; shared with the extension out of band
ALLOWED_ORIGINS=chrome-extension://REPLACE_WITH_EXTENSION_ID

# Budget. Reservations are conservative estimates per call, settled against
# provider-reported cost when the response includes it.
BUDGET_USD_DAILY=5
EST_SEARCH_CALL_USD=0.25
EST_GENERATION_CALL_USD=0.05
PRICING_VERSION=xai-docs-2026-10-24

MAX_CONCURRENT_JOBS=2
PROVIDER_TIMEOUT_MS=60000
JOB_TIMEOUT_MS=150000
X_REPLY_LIMIT=280
