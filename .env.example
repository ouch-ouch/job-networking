# The ONE environment file for this repo: copy to .env (gitignored) and fill in.
# The backend (npm run server) and the extension build (npm run build) both read it.
# Never commit .env or paste real keys into chat. Share secrets with teammates privately.

# ---- Backend: Grok via xAI (one server for everything) ----
XAI_API_KEY=
PORT=8787
PROVIDER_MODE=live            # live | fixture (fixture = labeled demo research, no xAI calls)
XAI_MODEL=grok-4.7            # X research + person drafts; must support the x_search tool
XAI_DRAFT_MODEL=grok-4.7      # template filling, questions, prep briefs
XAI_CLASSIFY_MODEL=grok-4.7   # reply classification
# Shared secret between the extension and the backend's /v1 X-research routes, >= 16 chars.
# Pick any random string; the build bakes it into the extension (fine for a local demo).
BACKEND_TOKEN=
# Who may call /v1 from a browser. The pinned extension ID plus the local preview.
ALLOWED_ORIGINS=chrome-extension://baeippkikgolnalkpiabdfhidjpploaa,http://127.0.0.1:5173
# Optional: restrict /ai callers to these extension IDs (comma-separated).
ALLOWED_EXTENSION_IDS=

# Budget guard for X research. Estimates, settled against provider-reported cost.
BUDGET_USD_DAILY=5
EST_SEARCH_CALL_USD=0.25
EST_GENERATION_CALL_USD=0.05
MAX_CONCURRENT_JOBS=2
PROVIDER_TIMEOUT_MS=60000
JOB_TIMEOUT_MS=150000
X_REPLY_LIMIT=280

# ---- Extension build ----
# Public OAuth client ID (Chrome Extension type, made for ID baeippkikgolnalkpiabdfhidjpploaa). Not secret.
GOOGLE_CLIENT_ID=
# Leave blank to use the team's pinned public key (extension ID baeippkikgolnalkpiabdfhidjpploaa).
EXTENSION_PUBLIC_KEY=

# ---- Snowflake (optional: storage only; Cortex AI is blocked on the trial account) ----
SNOWFLAKE_ACCOUNT_URL=
SNOWFLAKE_PAT=
