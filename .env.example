# Copy this file to .env and fill in the values. .env is gitignored; this file is not,
# so never put real values here. Get the Snowflake token from Rachel via a password
# manager (not Slack).

# Snowsight: bottom-left account menu -> "Connect a tool" -> account URL
SNOWFLAKE_ACCOUNT_URL=

# A programmatic access token for user COFFEE_CHAT_SVC (see snowflake/setup.sql step 7)
SNOWFLAKE_PAT=

# Google Cloud console -> Clients -> ends in .apps.googleusercontent.com (not secret)
GOOGLE_CLIENT_ID=
