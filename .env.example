# Copy to .env. Never commit or paste your API key into chat or the extension.
XAI_API_KEY=
XAI_DRAFT_MODEL=grok-4.7
XAI_CLASSIFY_MODEL=grok-4.7
PORT=8787

# Public OAuth client ID, application type Chrome Extension. No client secret.
GOOGLE_CLIENT_ID=
# Optional pinned public extension key (not a private signing key).
EXTENSION_PUBLIC_KEY=
# Optional comma-separated IDs allowed to call the local backend.
ALLOWED_EXTENSION_IDS=
